# Firebase web config for PRODUCTION builds.
#
# These four values are PUBLIC by design — they ship inside the JS bundle and are
# readable by anyone. Security is enforced by Firestore Security Rules, not by
# hiding these. That is why this file is committed to the repo: it lets any build
# (your machine, Cloudflare Workers Builds, CI) inline them without extra setup.
#
# Precedence: `vite build` (mode=production) reads this file, and it WINS over
# `.env.local`. `vite dev` (mode=development) ignores it and uses `.env.local`.
# If you ever split the two environments, keep the pairs in sync.
#
# VITE_FIREBASE_PROJECT_ID must match FIREBASE_PROJECT_ID in wrangler.jsonc —
# the Worker verifies every ID token's audience against it.

VITE_FIREBASE_API_KEY=AIzaSyBaLCPy0TUomQLEPmORDyktNiq9jq84H6k

VITE_FIREBASE_AUTH_DOMAIN=wordcrew.firebaseapp.com

VITE_FIREBASE_PROJECT_ID=wordcrew

VITE_FIREBASE_APP_ID=1:133675779874:web:295714d64aef6e4956c77b
