rules_version = '2';

// WordCrew — Firestore security rules (bản ghi trong repo).
//
// File này phản chiếu ĐÚNG ruleset cần dán lên Firebase console
// (Firestore Database → Rules). Dự án deploy bằng Wrangler nên không có
// firebase.json / Firebase CLI: console mới là nguồn thật, còn file này để
// versioned và để lần sau biết đang có gì mà chỉnh cho khớp.
//
// Client chỉ chạm đúng hai nhánh:
//
//   users/{uid}
//     Hồ sơ người chơi + các counter tiến độ mà tab "My progress" đọc:
//       roundsPlayed, bestScore, wordsGuessed, bestStreak   (services/progress.ts)
//       playStreak, lastPlayedDate                          (chuỗi ngày chơi liên tiếp)
//     Client ghi bằng merge: AuthContext.tsx (hồ sơ + presence) và
//     services/progress.ts (counter).
//
//     Tên hiển thị:
//       - Chủ tài khoản được tự đổi displayName, nhưng chỉ khi đã qua 30 ngày kể
//         từ displayNameUpdatedAt của lần đổi trước. Rule kiểm tra lại điều này,
//         nên sửa client cũng không lách được cooldown.
//       - Admin được đổi tên bất kỳ ai, bất kỳ lúc nào (không bị cooldown chặn).
//
//     Presence: online + lastSeenAt do client heartbeat mỗi 60 giây; lastLoginAt
//     được ghi mỗi lần đăng nhập. Admin dashboard đọc hai field này.
//
//     Role: role = 'teacher' | 'student' (thiếu field = student). Đây là quyền mở
//     Teacher Mode, CHỈ admin được ghi — chủ tài khoản tự phong giáo viên sẽ bị
//     rule từ chối. Admin (theo ADMIN_EMAILS) mặc định đã là teacher, không cần
//     ghi field này.
//
//   soloLeaderboards/{boardId}/periods/{period}/scores/{uid}
//     Một dòng mỗi người chơi mỗi board mỗi kỳ. boardId là id track ('rookie',
//     'explorer', 'challenger', 'master') hoặc 'daily' cho Today's Challenge.
//     Track reset hằng THÁNG (period = "2026-10"), Today's Challenge reset hằng
//     ngày (period = "2026-10-16").
//
//     Scores nằm *dưới* kỳ của nó, nên sang kỳ mới là một cuộc đua mới và mọi
//     tháng đã qua vẫn còn nguyên trên Firestore — admin dashboard đọc lại làm
//     "monthly records". Không cần cron, không cần collection thứ hai.
//
//     Doc periods/{period} chỉ là dấu "kỳ này có người chơi" để dashboard liệt
//     kê các tháng; nó được ghi kèm mỗi lần submit điểm.
//
//   classes/{classId}                       (My Class — giáo viên tạo)
//     members/{emailKey}                    danh sách lớp, email viết thường
//     assignments/{assignmentId}            bài giao: vocabulary | quiz | writing
//     submissions/{assignmentId__uid}       bài nộp, mỗi học sinh một doc
//   classCodes/{CODE}                       danh bạ mã lớp: code → classId, không gì khác
//
//     Quyền trong My Class suy ra TỪ DOC LỚP, không từ users/{uid} của ai:
//       - Giáo viên chỉ chạm được lớp có teacherUid == uid của mình.
//       - Học sinh đọc bài/ghi bài nộp chỉ khi email của mình nằm trong members và
//         đã join (status = 'active'). Thêm email vào lớp KHÔNG mở quyền gì trên
//         hồ sơ người dùng đó — giáo viên không đọc được users/{uid} của học sinh.
//       - Admin đi qua nhánh isAdmin() như mọi nơi khác.
//
//     classCodes là danh bạ công khai trong phạm vi đã đăng nhập: biết mã thì tra
//     ra classId, nhưng muốn đọc dữ liệu vẫn phải có email trong members. Không ai
//     list được toàn bộ mã (chống thu thập code).
//
// ⚠️ ADMIN: sửa danh sách trong adminEmails() bên dưới cho khớp ĐÚNG giá trị
//    secret ADMIN_EMAILS của Cloudflare Worker. Firestore rules không đọc được
//    biến môi trường của Worker, nên danh sách này phải được chép tay. Email
//    phải là email tài khoản Firebase đã đăng nhập (Google hoặc email/mật khẩu).
//
// Orders / licences / entitlements KHÔNG nằm ở đây — chúng ở Cloudflare Worker
// (D1) và client không bao giờ đi qua Firestore để lấy.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Chép tay từ ADMIN_EMAILS (Cloudflare secret), viết thường, cách nhau dấu phẩy.
    function adminEmails() {
      return [
        'admin@example.com'
      ];
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email is string
        && request.auth.token.email.lower() in adminEmails();
    }

    // Email đã chuẩn hoá của người đang đăng nhập — cũng chính là id của member doc.
    // Tài khoản không có email (hiếm) trả về chuỗi rỗng nên mọi so sánh đều false.
    function myEmail() {
      return request.auth != null && request.auth.token.email is string
        ? request.auth.token.email.lower()
        : '';
    }

    function classDoc(classId) {
      return get(/databases/$(database)/documents/classes/$(classId)).data;
    }

    // Giáo viên sở hữu lớp. Dùng get() nên trả false (thay vì lỗi) khi lớp không tồn tại.
    function isClassTeacher(classId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/classes/$(classId))
        && classDoc(classId).teacherUid == request.auth.uid;
    }

    // Học sinh đã join lớp: email nằm trong roster VÀ đã nhập mã (status active).
    // Được add email nhưng chưa join thì chưa đọc được bài.
    function isClassMember(classId) {
      return isSignedIn()
        && myEmail() != ''
        && exists(/databases/$(database)/documents/classes/$(classId)/members/$(myEmail()))
        && get(/databases/$(database)/documents/classes/$(classId)/members/$(myEmail())).data.status == 'active';
    }

    // ── Hồ sơ người dùng + counter tiến độ ───────────────────────────────

    match /users/{userId} {
      // Chủ tài khoản đọc hồ sơ của mình; admin đọc toàn bộ directory.
      allow read: if isOwner(userId) || isAdmin();

      // Tạo hồ sơ: chỉ chủ tài khoản, với field cơ bản hợp lệ.
      allow create: if isOwner(userId) && isValidProfileCreate(request.resource.data);

      // Cập nhật: admin được làm mọi thứ (kể cả đổi role); chủ tài khoản chỉ được
      // đổi displayName khi đã hết cooldown 30 ngày (các field khác như
      // counter/presence thì tự do, nhưng role thì không).
      allow update: if isAdmin()
        || (isOwner(userId)
            && isValidProfileUpdate()
            && roleUntouched()
            && renameAllowed());

      // Không cho client xoá tài khoản.
      allow delete: if false;
    }

    // Field hồ sơ hợp lệ. Chỉ chặn những gì thực sự cần: tên hiển thị phải là
    // chuỗi 2–24 ký tự và online phải là bool. Các counter tiến độ được để tự do
    // để thêm counter mới không phải sửa rules. Role bị loại khỏi create: quyền
    // giáo viên chỉ admin cấp sau đó, không đi kèm lúc tạo hồ sơ.
    function isValidProfileCreate(data) {
      return (!data.keys().hasAny(['displayName'])
          || (data.displayName is string
              && data.displayName.size() >= 2
              && data.displayName.size() <= 24))
        && (!data.keys().hasAny(['online']) || data.online is bool)
        && !data.keys().hasAny(['role', 'roleUpdatedAt']);
    }

    // Khi update, chỉ kiểm tra displayName nếu request thực sự đổi nó — nhờ vậy
    // hồ sơ cũ (tên Google dài hơn 24 ký tự) vẫn ghi được presence/counter.
    function isValidProfileUpdate() {
      return (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['displayName'])
          || (request.resource.data.displayName is string
              && request.resource.data.displayName.size() >= 2
              && request.resource.data.displayName.size() <= 24))
        && (!request.resource.data.keys().hasAny(['online']) || request.resource.data.online is bool);
    }

    // Quyền giáo viên là field do admin cấp; chủ tài khoản không được chạm vào
    // (kể cả tự hạ mình xuống student). Admin đi qua nhánh isAdmin() ở trên nên
    // không bị helper này chặn.
    function roleUntouched() {
      return !request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasAny(['role', 'roleUpdatedAt']);
    }

    // Cooldown đổi tên. Chỉ áp dụng khi request thực sự chạm vào displayName —
    // heartbeat, counter tiến độ và lastLoginAt không bị chặn.
    //
    // Lần đổi hợp lệ phải:
    //   1. ghi displayNameUpdatedAt = request.time (client dùng serverTimestamp),
    //   2. và hoặc hồ sơ chưa từng đổi tên, hoặc đã qua 30 ngày.
    function renameAllowed() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['displayName'])
        || (
          request.resource.data.displayNameUpdatedAt == request.time
          && (
            !resource.data.keys().hasAny(['displayNameUpdatedAt'])
            || request.time >= resource.data.displayNameUpdatedAt + duration.value(30, 'd')
          )
        );
    }

    // ── Bảng xếp hạng Solo (theo tháng / theo ngày) ──────────────────────

    match /soloLeaderboards/{boardId}/periods/{period} {
      // Danh sách kỳ (tháng) công khai — admin dashboard dựng "monthly records".
      allow read: if true;

      // Chỉ được tạo/cập nhật dấu kỳ khi đang đăng nhập và payload đúng tối thiểu.
      allow create, update: if isSignedIn()
        && request.resource.data.keys().hasOnly(['period', 'updatedAt'])
        && request.resource.data.period == period
        && request.resource.data.updatedAt is number;

      allow delete: if false;

      match /scores/{uid} {
        // Bảng công khai: cả người chưa đăng nhập vẫn xem được.
        allow read: if true;

        // Chỉ được tạo doc của chính mình, đúng kỳ đang ghi, dữ liệu hợp lệ.
        allow create: if isSignedIn()
          && request.auth.uid == uid
          && request.resource.data.period == period
          && isValidSoloEntry(request.resource.data);

        // Cập nhật khi điểm MỚI CAO HƠN (kỷ lục không bao giờ giảm) — hoặc khi
        // chỉ đổi tên hiển thị (điểm giữ nguyên nên vẫn thoả >=). Sang kỳ mới
        // là doc mới dưới period mới, nên không cần nới điều kiện này.
        allow update: if isSignedIn()
          && request.auth.uid == uid
          && request.resource.data.period == period
          && isValidSoloEntry(request.resource.data)
          && request.resource.data.score >= resource.data.score;

        // Điểm là kỷ lục cá nhân — không cho xoá.
        allow delete: if false;
      }
    }

    // Entry Solo hợp lệ: đúng các field, giá trị hợp lý.
    function isValidSoloEntry(data) {
      return data.keys().hasAll(['uid', 'name', 'score', 'wordsGuessed', 'bestStreak', 'updatedAt', 'period'])
        && data.keys().hasOnly(['uid', 'name', 'score', 'wordsGuessed', 'bestStreak', 'updatedAt', 'period'])
        && data.uid == request.auth.uid
        && data.name is string && data.name.size() > 0 && data.name.size() <= 40
        && data.score is number && data.score >= 0 && data.score <= 1000000
        && data.wordsGuessed is number && data.wordsGuessed >= 0 && data.wordsGuessed <= 1000000
        && data.bestStreak is number && data.bestStreak >= 0 && data.bestStreak <= 100000
        && data.updatedAt is number
        && data.period is string
        && (data.period.size() == 7 || data.period.size() == 10);
    }

    // ── My Class: lớp học, bài giao, bài nộp ─────────────────────────────

    match /classes/{classId} {
      // Giáo viên sở hữu đọc lớp của mình; học sinh đã join đọc được lớp để biết tên
      // và giáo viên. Danh sách lớp (dashboard giáo viên) dùng query
      // where('teacherUid','==',uid) nên phải kiểm bằng field, không bằng get().
      allow get: if isClassTeacher(classId) || isClassMember(classId) || isAdmin();
      allow list: if isAdmin() || (isSignedIn() && resource.data.teacherUid == request.auth.uid);

      allow create: if isSignedIn()
        && isValidClass(request.resource.data)
        && request.resource.data.teacherUid == request.auth.uid
        && request.resource.data.teacherEmail == myEmail();

      // Đổi tên lớp được; đổi chủ sở hữu thì không (quyền đi theo teacherUid).
      allow update: if (isClassTeacher(classId) || isAdmin())
        && isValidClass(request.resource.data)
        && request.resource.data.teacherUid == resource.data.teacherUid;

      allow delete: if isClassTeacher(classId) || isAdmin();

      // ── Danh sách lớp (roster) ──
      match /members/{memberEmail} {
        // Học sinh đọc đúng dòng của mình (cần cho lúc join); giáo viên đọc cả roster.
        allow get: if isClassTeacher(classId) || isAdmin() || memberEmail == myEmail();
        allow list: if isClassTeacher(classId) || isAdmin();

        // Giáo viên add email: trạng thái đầu tiên luôn là 'invited', uid còn trống.
        allow create: if isClassTeacher(classId)
          && isValidMember(request.resource.data)
          && request.resource.data.email == memberEmail
          && request.resource.data.status == 'invited'
          && request.resource.data.uid == null
          && request.resource.data.joinedAt == null;

        // Giáo viên sửa được (đổi tên hiển thị). Học sinh chỉ được tự "kích hoạt"
        // dòng của chính mình khi nhập đúng mã — và chỉ chạm 4 field đó thôi.
        allow update: if isClassTeacher(classId)
          || (memberEmail == myEmail()
              && isSignedIn()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid', 'name', 'status', 'joinedAt'])
              && request.resource.data.email == resource.data.email
              && request.resource.data.uid == request.auth.uid
              && request.resource.data.status == 'active'
              && request.resource.data.joinedAt is number);

        allow delete: if isClassTeacher(classId) || isAdmin();
      }

      // ── Bài giao ──
      match /assignments/{assignmentId} {
        // Học sinh đã join đọc được bài; người được add email nhưng chưa join thì không.
        allow get, list: if isClassTeacher(classId) || isClassMember(classId) || isAdmin();

        allow create: if isClassTeacher(classId) && isValidAssignment(request.resource.data);
        allow update: if isClassTeacher(classId) && isValidAssignment(request.resource.data);
        allow delete: if isClassTeacher(classId) || isAdmin();
      }

      // ── Bài nộp ──
      match /submissions/{submissionId} {
        allow get: if isClassTeacher(classId) || isAdmin()
          || (isClassMember(classId) && resource.data.uid == request.auth.uid);

        // Học sinh chỉ list được bài của mình — rule dùng resource.data nên query
        // bắt buộc phải có where('uid','==',uid) (xem fetchSubmissions).
        allow list: if isClassTeacher(classId) || isAdmin()
          || (isClassMember(classId) && resource.data.uid == request.auth.uid);

        // Học sinh nộp bài: đúng uid của mình, đúng email của mình, và không tự
        // đặt điểm/feedback của giáo viên.
        allow create: if isClassMember(classId)
          && isValidSubmission(request.resource.data)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.email == myEmail()
          && request.resource.data.graded == false
          && request.resource.data.feedback == '';

        // Làm lại: điểm và trạng thái pass chỉ được tăng (client đã giữ max), còn
        // field chấm bài thì bất động. Giáo viên chấm writing đi qua nhánh riêng.
        allow update: if isClassTeacher(classId) || isAdmin()
          || (isClassMember(classId)
              && request.resource.data.uid == request.auth.uid
              && resource.data.uid == request.auth.uid
              && isValidSubmission(request.resource.data)
              && request.resource.data.email == resource.data.email
              && request.resource.data.score >= resource.data.score
              && request.resource.data.graded == resource.data.graded
              && request.resource.data.feedback == resource.data.feedback);

        allow delete: if isClassTeacher(classId) || isAdmin();
      }
    }

    // ── Mã lớp: danh bạ code → classId ───────────────────────────────────

    match /classCodes/{code} {
      // Biết mã thì tra được classId. Chỉ get, không list: không ai thu thập được
      // toàn bộ mã đang tồn tại, và doc này không chứa gì ngoài classId.
      allow get: if isSignedIn();
      allow list: if false;

      // Chỉ giáo viên sở hữu lớp vừa tạo mới được đăng ký mã cho lớp đó — nếu không,
      // người khác có thể ghi đè mã của lớp mình không sở hữu.
      allow create: if isSignedIn()
        && code.matches('^[A-HJ-NP-Z2-9]{6}$')
        && request.resource.data.keys().hasAll(['classId', 'createdAt'])
        && request.resource.data.keys().hasOnly(['classId', 'createdAt'])
        && request.resource.data.classId is string
        && request.resource.data.createdAt is number
        && exists(/databases/$(database)/documents/classes/$(request.resource.data.classId))
        && classDoc(request.resource.data.classId).teacherUid == request.auth.uid;

      // Xoá lớp đi kèm xoá mã (deleteClass xoá mã trước, nên lớp vẫn còn để kiểm).
      allow delete: if isSignedIn()
        && exists(/databases/$(database)/documents/classes/$(resource.data.classId))
        && classDoc(resource.data.classId).teacherUid == request.auth.uid;

      allow update: if false;
    }

    function isValidClass(data) {
      return data.keys().hasAll(['name', 'joinCode', 'teacherUid', 'teacherEmail', 'teacherName', 'createdAt'])
        && data.keys().hasOnly(['name', 'joinCode', 'teacherUid', 'teacherEmail', 'teacherName', 'createdAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 40
        && data.joinCode is string && data.joinCode.size() == 6
        && data.teacherUid is string
        && data.teacherEmail is string
        && data.teacherName is string && data.teacherName.size() <= 80
        && data.createdAt is number;
    }

    function isValidMember(data) {
      return data.keys().hasAll(['email', 'name', 'uid', 'status', 'addedAt', 'joinedAt'])
        && data.keys().hasOnly(['email', 'name', 'uid', 'status', 'addedAt', 'joinedAt'])
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 320
        && data.name is string && data.name.size() <= 80
        && (data.uid == null || data.uid is string)
        && (data.status == 'invited' || data.status == 'active')
        && data.addedAt is number
        && (data.joinedAt == null || data.joinedAt is number);
    }

    // Bài giao: chỉ cần đúng hình dạng và trần kích thước. Nội dung là của giáo viên
    // nên không cần kiểm chặt hơn; cái cần chặn là payload khổng lồ.
    function isValidAssignment(data) {
      return data.keys().hasAll(['kind', 'title', 'instructions', 'createdAt', 'dueAt', 'passScore', 'words', 'questions', 'prompt', 'minWords'])
        && data.keys().hasOnly(['kind', 'title', 'instructions', 'createdAt', 'dueAt', 'passScore', 'words', 'questions', 'prompt', 'minWords'])
        && data.kind in ['vocabulary', 'quiz', 'writing']
        && data.title is string && data.title.size() > 0 && data.title.size() <= 120
        && data.instructions is string && data.instructions.size() <= 2000
        && data.createdAt is number
        && (data.dueAt == null || data.dueAt is number)
        && (data.passScore == null || (data.passScore is number && data.passScore >= 0 && data.passScore <= 100))
        && data.words is list && data.words.size() <= 60
        && data.questions is list && data.questions.size() <= 30
        && data.prompt is string && data.prompt.size() <= 2000
        && data.minWords is number && data.minWords >= 0 && data.minWords <= 400;
    }

    function isValidSubmission(data) {
      return data.keys().hasAll(['assignmentId', 'uid', 'email', 'name', 'kind', 'score', 'passed', 'attempts', 'detail', 'submittedAt', 'graded', 'feedback'])
        && data.keys().hasOnly(['assignmentId', 'uid', 'email', 'name', 'kind', 'score', 'passed', 'attempts', 'detail', 'submittedAt', 'graded', 'feedback'])
        && data.assignmentId is string && data.assignmentId.size() <= 128
        && data.uid is string
        && data.email is string
        && data.name is string && data.name.size() <= 80
        && data.kind in ['vocabulary', 'quiz', 'writing']
        && data.score is number && data.score >= 0 && data.score <= 100
        && data.passed is bool
        && data.attempts is number && data.attempts >= 1 && data.attempts <= 1000
        && data.detail is map
        && data.submittedAt is number
        && data.graded is bool
        && data.feedback is string && data.feedback.size() <= 2000;
    }

    // Mặc định chặn tất cả những thứ còn lại.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
