rules_version = '2';

// WordCrew — Firestore security rules (bản ghi trong repo).
//
// File này phản chiếu ĐÚNG ruleset đang chạy trên Firebase console
// (Firestore Database → Rules). Dự án deploy bằng Wrangler nên không có
// firebase.json / Firebase CLI: console mới là nguồn thật, còn file này để
// versioned và để lần sau biết đang có gì mà chỉnh cho khớp.
//
// Client chỉ chạm đúng hai collection:
//   users/{uid}
//     Hồ sơ người chơi + các counter tiến độ (roundsPlayed, bestScore,
//     wordsGuessed, bestStreak) mà tab "My progress" đọc. Client ghi bằng
//     merge: AuthContext.tsx (hồ sơ) và services/progress.ts (counter).
//
//   soloLeaderboards/{trackId}/scores/{uid}
//     Một dòng mỗi người chơi mỗi track. services/soloLeaderboard.ts đọc cả
//     bảng và chỉ ghi dòng mang uid của chính mình.
//
// Orders / licences / entitlements KHÔNG nằm ở đây — chúng ở Cloudflare Worker
// (D1) và client không bao giờ đi qua Firestore để lấy.

service cloud.firestore {
  match /databases/{database}/documents {

    // Hồ sơ người dùng (giữ nguyên như rule hiện tại của bạn)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // WordCrew — bảng xếp hạng Solo.
    // Mỗi người chơi 1 doc mỗi track: soloLeaderboards/{trackId}/scores/{uid}
    match /soloLeaderboards/{trackId}/scores/{uid} {
      // Bảng công khai: cả người đã đăng nhập lẫn offline đều xem được.
      allow read: if true;

      // Chỉ được tạo doc của chính mình, với dữ liệu hợp lệ.
      allow create: if request.auth != null
        && request.auth.uid == uid
        && isValidSoloEntry(request.resource.data);

      // ...và chỉ được cập nhật khi điểm MỚI CAO HƠN (kỷ lục không bao giờ giảm).
      allow update: if request.auth != null
        && request.auth.uid == uid
        && isValidSoloEntry(request.resource.data)
        && request.resource.data.score >= resource.data.score;

      // Điểm là kỷ lục cá nhân — không cho xoá.
      allow delete: if false;
    }

    // Entry Solo hợp lệ: đúng các field, giá trị hợp lý.
    function isValidSoloEntry(data) {
      return data.keys().hasAll(['uid', 'name', 'score', 'wordsGuessed', 'bestStreak', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'name', 'score', 'wordsGuessed', 'bestStreak', 'updatedAt'])
        && data.uid == request.auth.uid
        && data.name is string && data.name.size() > 0 && data.name.size() <= 40
        && data.score is number && data.score >= 0 && data.score <= 1000000
        && data.wordsGuessed is number && data.wordsGuessed >= 0 && data.wordsGuessed <= 1000000
        && data.bestStreak is number && data.bestStreak >= 0 && data.bestStreak <= 100000
        && data.updatedAt is number;
    }

    // Mặc định chặn tất cả những thứ còn lại.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
