{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wordcrew",
  // The API worker. Only /api/* reaches it; the game itself is served as static
  // assets (which Cloudflare does not charge requests for).
  "main": "worker/index.ts",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wordcrew-db",
      "database_id": "cf1901c3-549c-4558-8597-a31b440fa620"
    }
  ],
  // Speech recognition for devices that have no Web Speech API (Firefox, older
  // Android WebViews). Browsers with `SpeechRecognition` never reach this binding.
  "ai": {
    "binding": "AI"
  },
  "vars": {
    // Bank short code understood by qr.sepay.vn (MSB, MBBank, Vietcombank, TPBank, ...)
    // and the numbered account that receives the transfers. These are plain vars rather
    // than dashboard secrets on purpose: `wrangler deploy` overwrites every var declared
    // here on each build, so keeping them in the repo is what stops them being wiped.
    "SEPAY_BANK_NAME": "MSB",
    "SEPAY_BANK_ACCOUNT": "7204061994",
    // Public price of the one-time licence. Change here, no app rebuild needed.
    "PRICE_VND": "199000",
    // Firebase project whose ID tokens the worker validates before minting an order.
    // Leaving it blank disables the check (local dev only — never ship it blank).
    "FIREBASE_PROJECT_ID": "wordcrew"
  }
  // SEPAY_WEBHOOK_API_KEY is a secret — set it with:
  //   npx wrangler secret put SEPAY_WEBHOOK_API_KEY
}
